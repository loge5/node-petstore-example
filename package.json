{
  "name": "petstore-example",
  "version": "1.0.0",
  "description": "Example implementation of the openapi petstore",
  "repository": {
    "type": "git",
    "url": "git@github.com:loge5/node-petstore-example.git"
  },
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "jest",
    "cover": "jest --coverage",
    "format": "node node_modules/.bin/standard --fix",
    "prerelease": "npm test",
    "release": "standard-version",
    "postrelease": "git push --follow-tags origin master"
  },
  "keywords": [
    "example",
    "rest",
    "openapi",
    "swagger"
  ],
  "author": "Rolf Loges",
  "license": "MIT",
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "jest": "^30.5.2",
    "standard": "^17.1.2",
    "standard-version": "^9.5.0"
  },
  "dependencies": {
    "another-fluent-validator": "^1.6.5",
    "body-parser": "^2.3.0",
    "express": "^5.3.0"
  },
  "standard": {
    "ignore": [
      "swaggerui-dist"
    ]
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/lib/**/*.spec.js"
    ],
    "coverageReporters": [
      "html",
      "text"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/swaggerui-dist/",
      "/config/"
    ]
  }
}
