{
  "name": "petstore-example",
  "version": "1.0.0",
  "description": "Example implementation of the openapi petstore",
  "repository": {
    "type": "git",
    "url": "git@github.com:loge5/node-petstore-example.git"
  },
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "jest",
    "cover": "jest --coverage",
    "format": "standard --fix",
    "prerelease": "npm test",
    "release": "standard-version",
    "postrelease": "git push --follow-tags origin master"
  },
  "keywords": [
    "example",
    "rest",
    "openapi",
    "swagger"
  ],
  "author": "Rolf Loges",
  "license": "MIT",
  "engines": {
    "node": ">=18.14.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "jest": "^30.5.2",
    "standard": "^17.1.2",
    "standard-version": "^9.5.0"
  },
  "dependencies": {
    "another-fluent-validator": "^1.6.5",
    "express": "^5.3.0"
  },
  "standard": {
    "ignore": [
      "swaggerui-dist"
    ]
  },
  "jest": {
    "coverageReporters": [
      "html",
      "text"
    ],
    "collectCoverageFrom": [
      "lib/**/*.js",
      "routes/**/*.js",
      "!**/*.spec.js"
    ]
  }
}
